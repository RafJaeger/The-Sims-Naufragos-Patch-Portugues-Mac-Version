#!/bin/bash
set -eu

LANGUAGE="${PATCH_PORTUGUESE_LANGUAGE:-Portuguese}"

open_game() {
    GAME_PATH="$1"
    if [ -d "$GAME_PATH" ]; then
        exec /usr/bin/open "$GAME_PATH" --args "-l:$LANGUAGE"
    fi
}

if [ -n "${PATCH_PORTUGUESE_CASTAWAY_PATH:-}" ]; then
    open_game "$PATCH_PORTUGUESE_CASTAWAY_PATH"
else
    open_game "/Applications/The Sims Castaway Stories.localized/The Sims Castaway Stories.app"
    open_game "/Applications/The Sims Castaway Stories.app"
    open_game "$HOME/Applications/The Sims Castaway Stories.localized/The Sims Castaway Stories.app"
    open_game "$HOME/Applications/The Sims Castaway Stories.app"
fi

/usr/bin/osascript <<'APPLESCRIPT'
display dialog "The Sims Castaway Stories.app não foi encontrado em Aplicativos." & return & return & "Defina PATCH_PORTUGUESE_CASTAWAY_PATH se o jogo estiver em outro local." buttons {"OK"} with title "Patch Portuguese"
APPLESCRIPT
exit 1
